# secrets and local config
.env

# PERSONAL DATA — never commit. Your real profile stays on your machine only.
# The shipped template master_profile.example.yaml IS committed; your filled-in
# master_profile.yaml is not.
master_profile.yaml

# node
node_modules/
dist/

# python
backend/.venv/
__pycache__/
*.pyc

# local data (SQLite db with your profile + scanned jobs, generated packs, transcripts)
backend/data/

# internal build log (not needed by users of the shared project)
PROGRESS.md

# Launcher written by setup.command on the user's own machine, so that it
# carries no macOS quarantine flag and opens on a double-click.
Career Copilot.app/

# Retired launcher: a .command always opens Terminal, which is exactly what the
# .app bundle above avoids. Kept here so an older install's copy is not
# committed by accident.
career-copilot.command

# os
.DS_Store
Thumbs.db

# retired v1 (pre-app) CLI workflow, kept locally for reference only
_archive-cli-v1/

# AI agent artifacts (working notes, not part of the app)
.claude/
career-copilot/
