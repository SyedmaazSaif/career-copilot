# Copy to .env and adjust. .env is git-ignored; this example is safe to commit.
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Context window. Ollama's own default is 4096, which a resume plus the
# answer overflows. Raise only if you have RAM to spare.
OLLAMA_NUM_CTX=8192

# Per-request ceilings in seconds. A slow machine needs headroom; when a
# call does time out the app now says so instead of silently degrading.
OLLAMA_TIMEOUT=120
OLLAMA_JSON_TIMEOUT=300
